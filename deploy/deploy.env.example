# Host-specific values for deploy/deploy.sh — copy to deploy/deploy.env and
# edit.
#
#   cp deploy/deploy.env.example deploy/deploy.env    # then edit
#
# deploy.env is gitignored: it holds the broker password, which does not
# belong in a public fork. It lives next to the checkout on the deployment
# host (~/Development/telldus), not on a workstation — a deploy is an SSH
# session on the server.
#
# Sourced by bash, so quote anything with spaces and do not put trailing
# comments on a value line.

# Where stack config and data live on the host. On hubbabubba this is a
# dedicated Btrfs subvolume that Snapper snapshots and the backup engine
# mirrors, both locally and offsite. The deploying account must be able to
# create <APPDATA_ROOT>/telldus.
APPDATA_ROOT=/srv/appdata

# The Mosquitto broker. It is deployed by e9wikner/homeass on the same host
# with Network=host, so the bridge reaches it over the loopback address —
# these credentials must match that repo's own deploy.env.
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=hubbabubba
MQTT_PASSWORD=CHANGE_ME

# Bridge identity and topic scheme. These are the fork's own documented
# defaults; there is no reason to diverge from them unless a second bridge
# shares the broker. Home Assistant entities come from MQTT discovery under
# MQTT_DISCOVERY_PREFIX, built at runtime from the id and name of each device
# in tellstick.conf — there is no separate entity mapping to maintain.
MQTT_CLIENT_ID=telldus-mqtt
MQTT_TOPIC_PREFIX=telldus
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_QOS=1
