{
	"version": 3,
	"configurePresets": [
		{
			"name": "headless",
			"displayName": "Headless Linux Build",
			"description": "Configure telldus-core for headless Linux build with libftdi",
			"binaryDir": "${sourceDir}/build/headless",
			"cacheVariables": {
				"FORCE_COMPILE_FROM_TRUNK": "TRUE",
				"BUILD_TDTOOL": "TRUE",
				"BUILD_TDADMIN": "TRUE",
				"ENABLE_TESTING": "TRUE",
				"FTDI_ENGINE": "libftdi"
			}
		}
	]
}
